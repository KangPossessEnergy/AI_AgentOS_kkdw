# 飞书自建应用凭证（前面接入飞书时已经创建）
# Bot A（主力开发 bot）
BOT_A_APP_ID=cli_xxx
BOT_A_APP_SECRET=xxx

# Bot B（协作/审查 bot，后面进入多机器人协作时才需要）
BOT_B_APP_ID=
BOT_B_APP_SECRET=

# 测试话题群 chat_id（把 bot 拉进群后获取）
TEST_CHAT_ID=oc_xxx

# 你自己的 open_id（跑通 echo bot 后从日志 sender= 字段获取，审批/通知篇会用）
OWNER_OPEN_ID=ou_xxx

# 新话题默认使用的执行引擎：claude 或 codex
DEFAULT_CLI=codex

# AI 编程 CLI 执行任务的项目目录。必须填写为真正需要修改的本地仓库绝对路径。
# 留空时会修改本 Agent OS 项目本身。
CLI_WORKDIR=/Users/your-name/Developer/your-project

# 如果机器人进程提示 spawn codex/claude ENOENT，可填 CLI 的绝对路径。
# 先在普通终端执行 `which codex` 或 `which claude` 获取。
# CODEX_BIN=/Applications/ChatGPT.app/Contents/Resources/codex
# CLAUDE_BIN=/Users/your-name/.local/bin/claude

# 飞书是非交互入口，Claude Code 无法等待终端中的权限确认。
# acceptEdits：自动允许文件编辑，命令执行仍会要求确认（推荐）。
# bypassPermissions：跳过所有权限确认，仅限机器人只有你自己可发消息时使用。
# CLAUDE_PERMISSION_MODE=acceptEdits

# Claude Code / Codex 的模型后端使用各自的用户级配置管理
# 也可以使用 CC Switch 在不同模型服务之间切换
